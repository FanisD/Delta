# Keep the Docker build context small and exclude local/generated state.
.git
.github
.venv
**/.venv
node_modules
**/node_modules
frontend/dist
backend/.pytest_cache
backend/**/__pycache__
frontend/**/__pycache__
**/*.pyc
data
**/data
dist
desktop/target
desktop/binaries/*
!desktop/binaries/.gitkeep
*.log
.env
*.sqlite
*.db
