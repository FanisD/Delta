# Copy to .env. Never commit .env.
APP_DATABASE_URL=sqlite+aiosqlite:///../data/app.db
# Required to save cloud provider API keys. Generate once with:
# uv run --project backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_LLM_TIMEOUT_SECONDS=90
APP_LLM_MAX_RETRIES=2
APP_LLM_VALIDATION_RETRIES=2