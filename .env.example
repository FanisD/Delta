# Copy to .env. Never commit .env.
# Optional database URL override. Leave blank to use APP_DATA_DIR or the
# platform's application-data directory.
APP_DATABASE_URL=
# Optional OS-independent data location override for development/tests.
# Without this, Delta uses the platform's application-data directory.
APP_DATA_DIR=
# Optional path to a built frontend directory. Defaults to frontend/dist.
APP_FRONTEND_DIR=
# Required to save cloud provider API keys. Generate once with:
# uv run --project backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_LLM_TIMEOUT_SECONDS=90
APP_LLM_MAX_RETRIES=2
APP_LLM_VALIDATION_RETRIES=2