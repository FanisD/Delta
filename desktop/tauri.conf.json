{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta",
  "version": "0.1.0",
  "identifier": "com.fanisd.delta",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Delta", "url": "about:blank", "width": 1200, "height": 800, "minWidth": 900, "minHeight": 600, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "externalBin": ["binaries/delta-backend"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": []
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/FanisD/Delta/releases/latest/download/latest.json"],
      "dialog": true
    }
  }
}
